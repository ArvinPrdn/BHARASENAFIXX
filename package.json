{
  "name": "bharasena-ballroom",
  "version": "0.1.0",
  "private": true,
  "description": "Situs BHARASENA — Satu Malam di Ballroom",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "admin:create": "node scripts/admin-create.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.7.2",
    "eslint": "^9.39.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
