# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4321

# Session and request protection. Generate with a password manager or:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-a-random-32-byte-secret
TRUST_PROXY=0

# SQLite (Node 26's built-in node:sqlite)
DB_PATH=./data/bharasena.db

# Runtime origin for request and CSRF checks. SEO uses www.bharasena.com.
PUBLIC_ORIGIN=http://localhost:4321

# Set NODE_ENV=production only when TLS terminates before the app.

# Vercel Dinding Pesan: disabled until persistent storage is configured.
MESSAGE_WALL_ENABLED=false
MESSAGE_WALL_NAMESPACE=bharasena:wall:v1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional private Telegram notification. Keep both values server-side.
# Use a newly regenerated bot token; never commit real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
