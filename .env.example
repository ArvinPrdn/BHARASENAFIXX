# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4321

# Session and request protection. Generate with a password manager or:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-a-random-32-byte-secret
TRUST_PROXY=0

# SQLite (Node 26's built-in node:sqlite)
DB_PATH=./data/bharasena.db

# Public origin used for canonical links, sitemap, and CSRF Origin checks
PUBLIC_ORIGIN=http://localhost:4321

# Set NODE_ENV=production only when TLS terminates before the app.
